# Register this exact callback URL in your Spotify application settings.
spotify.clientId=
spotify.clientSecret=
spotify.redirectUri=http://127.0.0.1:8888/callback
# Optional for a later non-interactive flow; /start always performs OAuth.
spotify.accessToken=
# Optional single-user allowlist. Set this to the Spotify user ID allowed to log in.
spotify.allowedUserId=
