CREATE TABLE schema_version (
    singleton_id INTEGER NOT NULL PRIMARY KEY,
    version INTEGER NOT NULL
);

CREATE TABLE spotify_auth_grants (
    spotify_user_id TEXT NOT NULL PRIMARY KEY,
    protected_refresh_token TEXT NOT NULL,
    authorized_at_millis INTEGER NOT NULL,
    last_refreshed_at_millis INTEGER
);

CREATE TABLE browser_sessions (
    session_id TEXT NOT NULL PRIMARY KEY,
    spotify_user_id TEXT NOT NULL,
    created_at_millis INTEGER NOT NULL,
    last_used_at_millis INTEGER NOT NULL,
    expires_at_millis INTEGER NOT NULL
);

CREATE INDEX browser_sessions_user_id ON browser_sessions (spotify_user_id);

CREATE TABLE cache_source_sync (
    owner_spotify_user_id TEXT NOT NULL,
    source_key TEXT NOT NULL,
    resource_kind TEXT NOT NULL,
    status TEXT NOT NULL,
    source_revision TEXT,
    last_synced_at_millis INTEGER,
    item_count INTEGER,
    last_error_code TEXT,
    last_error_at_millis INTEGER,
    PRIMARY KEY (owner_spotify_user_id, source_key)
);

CREATE TABLE top_artists (
    owner_spotify_user_id TEXT NOT NULL,
    source_position INTEGER NOT NULL,
    name TEXT NOT NULL,
    id TEXT NOT NULL,
    href TEXT NOT NULL,
    uri TEXT NOT NULL,
    PRIMARY KEY (owner_spotify_user_id, source_position)
);

CREATE TABLE top_tracks (
    owner_spotify_user_id TEXT NOT NULL,
    source_position INTEGER NOT NULL,
    name TEXT NOT NULL,
    id TEXT NOT NULL,
    href TEXT NOT NULL,
    uri TEXT NOT NULL,
    track_json TEXT NOT NULL,
    PRIMARY KEY (owner_spotify_user_id, source_position)
);

CREATE TABLE saved_tracks (
    owner_spotify_user_id TEXT NOT NULL,
    source_position INTEGER NOT NULL,
    name TEXT NOT NULL,
    id TEXT NOT NULL,
    primary_artist_id TEXT,
    release_date TEXT,
    release_year INTEGER,
    href TEXT NOT NULL,
    uri TEXT NOT NULL,
    added_at TEXT,
    track_json TEXT NOT NULL,
    PRIMARY KEY (owner_spotify_user_id, source_position)
);

CREATE TABLE playlists (
    owner_spotify_user_id TEXT NOT NULL,
    source_position INTEGER NOT NULL,
    name TEXT NOT NULL,
    id TEXT NOT NULL,
    href TEXT NOT NULL,
    uri TEXT NOT NULL,
    tracks_href TEXT NOT NULL,
    PRIMARY KEY (owner_spotify_user_id, source_position),
    UNIQUE (owner_spotify_user_id, id)
);

CREATE TABLE playlist_tracks (
    owner_spotify_user_id TEXT NOT NULL,
    playlist_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    playlist_name TEXT NOT NULL,
    added_at TEXT,
    release_date TEXT,
    release_year INTEGER,
    name TEXT NOT NULL,
    primary_artist_id TEXT,
    id TEXT NOT NULL,
    href TEXT NOT NULL,
    uri TEXT NOT NULL,
    track_json TEXT NOT NULL,
    PRIMARY KEY (owner_spotify_user_id, playlist_id, position)
);

CREATE TABLE playlist_details (
    owner_spotify_user_id TEXT NOT NULL,
    playlist_id TEXT NOT NULL,
    description TEXT,
    is_public INTEGER,
    collaborative INTEGER,
    owner_id TEXT,
    item_count INTEGER,
    display_url TEXT,
    PRIMARY KEY (owner_spotify_user_id, playlist_id)
);

CREATE TABLE playlist_items (
    owner_spotify_user_id TEXT NOT NULL,
    playlist_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    added_at TEXT,
    added_by_id TEXT,
    is_local INTEGER NOT NULL,
    item_type TEXT,
    is_playable INTEGER NOT NULL,
    item_id TEXT,
    item_uri TEXT,
    status TEXT NOT NULL,
    complete_item_json TEXT NOT NULL,
    PRIMARY KEY (owner_spotify_user_id, playlist_id, position)
);

CREATE TABLE songs (
    owner_spotify_user_id TEXT NOT NULL,
    id TEXT NOT NULL,
    name TEXT NOT NULL,
    href TEXT NOT NULL,
    uri TEXT NOT NULL,
    album_id TEXT,
    album_name TEXT,
    album_href TEXT,
    album_uri TEXT,
    release_date TEXT,
    duration_ms INTEGER,
    explicit INTEGER,
    available INTEGER NOT NULL,
    track_json TEXT NOT NULL,
    PRIMARY KEY (owner_spotify_user_id, id)
);

CREATE TABLE song_artists (
    owner_spotify_user_id TEXT NOT NULL,
    track_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    artist_id TEXT,
    name TEXT,
    href TEXT,
    uri TEXT,
    PRIMARY KEY (owner_spotify_user_id, track_id, position)
);

CREATE TABLE managed_playlists (
    owner_spotify_user_id TEXT NOT NULL,
    definition_id TEXT NOT NULL,
    spotify_playlist_id TEXT NOT NULL,
    created_at_millis INTEGER NOT NULL,
    last_synced_at_millis INTEGER,
    last_seen_snapshot_id TEXT,
    PRIMARY KEY (owner_spotify_user_id, definition_id),
    UNIQUE (owner_spotify_user_id, spotify_playlist_id)
);

CREATE TABLE user_playlist_definitions (
    id TEXT NOT NULL,
    owner_spotify_user_id TEXT NOT NULL,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    enabled INTEGER NOT NULL,
    recipe_payload TEXT NOT NULL,
    PRIMARY KEY (owner_spotify_user_id, id)
);

CREATE TABLE user_playlist_definition_items (
    owner_spotify_user_id TEXT NOT NULL,
    definition_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    recipe_item_payload TEXT NOT NULL,
    PRIMARY KEY (owner_spotify_user_id, definition_id, position),
    FOREIGN KEY (owner_spotify_user_id, definition_id)
        REFERENCES user_playlist_definitions(owner_spotify_user_id, id) ON DELETE CASCADE
);

CREATE TABLE playlist_recipe_preferences (
    owner_spotify_user_id TEXT NOT NULL,
    definition_id TEXT NOT NULL,
    shuffle_after_generation INTEGER NOT NULL,
    PRIMARY KEY (owner_spotify_user_id, definition_id)
);

CREATE INDEX playlist_items_owner_playlist_position
    ON playlist_items (owner_spotify_user_id, playlist_id, position);

CREATE INDEX cache_source_sync_owner_status
    ON cache_source_sync (owner_spotify_user_id, status);

CREATE INDEX user_playlist_definitions_owner_id
    ON user_playlist_definitions (owner_spotify_user_id, id);
