CREATE TABLE top_artists (
    name TEXT,
    id TEXT,
    href TEXT,
    uri TEXT
);

CREATE TABLE top_tracks (
    name TEXT,
    id TEXT,
    href TEXT,
    uri TEXT,
    track_json TEXT
);

CREATE TABLE saved_tracks (
    name TEXT,
    id TEXT,
    primary_artist_id TEXT,
    release_date TEXT,
    release_year INTEGER,
    href TEXT,
    uri TEXT,
    added_at TEXT,
    track_json TEXT
);

CREATE TABLE playlists (
    name TEXT,
    id TEXT,
    href TEXT,
    uri TEXT,
    tracks_href TEXT,
    snapshot_id TEXT
);

CREATE TABLE playlist_tracks (
    playlist_name TEXT,
    added_at TEXT,
    release_date TEXT,
    release_year INTEGER,
    name TEXT,
    primary_artist_id TEXT,
    id TEXT,
    href TEXT,
    uri TEXT,
    track_json TEXT
);

CREATE TABLE sync_status (
    sync_timestamp_millis INTEGER
);

CREATE TABLE cache_metadata (
    singleton_id INTEGER NOT NULL PRIMARY KEY,
    cache_revision TEXT NOT NULL,
    sync_timestamp_millis INTEGER NOT NULL,
    owner_spotify_user_id TEXT,
    completion_state TEXT NOT NULL
);

CREATE TABLE playlist_details (
    playlist_id TEXT NOT NULL PRIMARY KEY,
    description TEXT,
    is_public INTEGER,
    collaborative INTEGER,
    owner_id TEXT,
    snapshot_id TEXT,
    item_count INTEGER,
    display_url TEXT
);

CREATE TABLE playlist_items (
    playlist_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    added_at TEXT,
    added_by_id TEXT,
    is_local INTEGER NOT NULL,
    item_type TEXT,
    is_playable INTEGER NOT NULL,
    item_id TEXT,
    item_uri TEXT,
    status TEXT NOT NULL,
    complete_item_json TEXT NOT NULL,
    PRIMARY KEY (playlist_id, position)
);

CREATE TABLE songs (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    href TEXT NOT NULL,
    uri TEXT NOT NULL,
    album_id TEXT,
    album_name TEXT,
    album_href TEXT,
    album_uri TEXT,
    release_date TEXT,
    duration_ms INTEGER,
    explicit INTEGER,
    available INTEGER NOT NULL,
    track_json TEXT NOT NULL
);

CREATE TABLE song_artists (
    track_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    artist_id TEXT,
    name TEXT,
    href TEXT,
    uri TEXT,
    PRIMARY KEY (track_id, position)
);

CREATE TABLE managed_playlists (
    definition_id TEXT NOT NULL,
    definition_revision TEXT NOT NULL,
    spotify_playlist_id TEXT NOT NULL,
    owner_spotify_user_id TEXT NOT NULL,
    PRIMARY KEY (definition_id, definition_revision),
    UNIQUE (spotify_playlist_id, owner_spotify_user_id)
);

syncStatusCount:
SELECT count(*)
FROM sync_status;

exportTopArtists:
SELECT name, id, href, uri
FROM top_artists
ORDER BY name, id, href, uri;

exportTopTracks:
SELECT name, id, href, uri, track_json
FROM top_tracks
ORDER BY name, id, href, uri, track_json;

exportSavedTracks:
SELECT name, id, primary_artist_id, release_date, release_year, href, uri, added_at, track_json
FROM saved_tracks
ORDER BY name, id, primary_artist_id, release_date, release_year, href, uri, added_at, track_json;

exportPlaylists:
SELECT name, id, href, uri, tracks_href, snapshot_id
FROM playlists
ORDER BY name, id, href, uri, tracks_href, snapshot_id;

exportPlaylistTracks:
SELECT playlist_name, added_at, release_date, release_year, name, primary_artist_id, id, href, uri, track_json
FROM playlist_tracks
ORDER BY playlist_name, name, id, primary_artist_id, release_date, release_year, href, uri, added_at, track_json;

exportSyncStatus:
SELECT sync_timestamp_millis
FROM sync_status
ORDER BY sync_timestamp_millis;

clearTopArtists:
DELETE FROM top_artists;

clearTopTracks:
DELETE FROM top_tracks;

clearSavedTracks:
DELETE FROM saved_tracks;

clearPlaylists:
DELETE FROM playlists;

clearPlaylistTracks:
DELETE FROM playlist_tracks;

clearSyncStatus:
DELETE FROM sync_status;

insertSavedTrack:
INSERT INTO saved_tracks (
    name,
    id,
    primary_artist_id,
    release_date,
    release_year,
    href,
    uri,
    added_at,
    track_json
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertTopTrack:
INSERT INTO top_tracks (name, id, href, uri, track_json)
VALUES (?, ?, ?, ?, ?);

insertTopArtist:
INSERT INTO top_artists (name, id, href, uri)
VALUES (?, ?, ?, ?);

insertPlaylist:
INSERT INTO playlists (name, id, href, uri, tracks_href, snapshot_id)
VALUES (?, ?, ?, ?, ?, ?);

insertPlaylistTrack:
INSERT INTO playlist_tracks (
    playlist_name,
    added_at,
    release_date,
    release_year,
    name,
    primary_artist_id,
    id,
    href,
    uri,
    track_json
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertSyncStatus:
INSERT INTO sync_status (sync_timestamp_millis)
VALUES (?);

selectDuplicateSavedTrackRows:
SELECT primary_artist_id, name, id, added_at
FROM saved_tracks
WHERE (name, primary_artist_id) IN (
    SELECT name, primary_artist_id
    FROM saved_tracks
    GROUP BY name, primary_artist_id
    HAVING COUNT(*) > 1
)
ORDER BY primary_artist_id, name, added_at DESC;

deleteSavedTracksById:
DELETE FROM saved_tracks
WHERE id = ?;

selectRecentLikedTracks:
SELECT id, uri, primary_artist_id, track_json
FROM saved_tracks
ORDER BY added_at DESC
LIMIT ?;

selectRandomLikedTracks:
SELECT id, uri, primary_artist_id, track_json
FROM saved_tracks
ORDER BY RANDOM()
LIMIT ?;

selectAllSavedCandidates:
SELECT id, uri, primary_artist_id, added_at, track_json
FROM saved_tracks
ORDER BY added_at DESC, id, uri, track_json;

selectAllTopCandidates:
SELECT id, uri, track_json
FROM top_tracks
ORDER BY id, uri, track_json;

selectTopArtistIds:
SELECT id
FROM top_artists
ORDER BY id;

selectTopTrackIds:
SELECT id
FROM top_tracks
ORDER BY id;

selectPlaylistCandidatesByName:
SELECT id, uri, added_at, track_json
FROM playlist_tracks
WHERE playlist_name = ?
ORDER BY added_at, id, uri, track_json;

selectCollectedDiscoverWeekly:
SELECT id, uri, primary_artist_id, track_json
FROM playlist_tracks
WHERE playlist_name = ?
UNION
SELECT id, uri, primary_artist_id, track_json
FROM playlist_tracks
WHERE playlist_name = ?
  AND release_year >= ?
  AND id NOT IN (
      SELECT id
      FROM playlist_tracks
      WHERE playlist_name = ?
  );

selectSavedTracksPerArtist:
SELECT id, uri, primary_artist_id, track_json
FROM (
    SELECT id, uri, primary_artist_id, track_json,
           row_number() OVER (
               PARTITION BY primary_artist_id
               ORDER BY RANDOM()
           ) AS row_number
    FROM saved_tracks
)
WHERE row_number <= ?;

selectSavedTracksInYearRangePerArtist:
SELECT id, uri, primary_artist_id, track_json
FROM (
    SELECT id, uri, primary_artist_id, track_json,
           row_number() OVER (
               PARTITION BY primary_artist_id
               ORDER BY RANDOM()
           ) AS row_number
    FROM saved_tracks
    WHERE release_year >= ? AND release_year <= ?
)
WHERE row_number <= ?;

selectSavedTracksThroughYearPerArtist:
SELECT id, uri, primary_artist_id, track_json
FROM (
    SELECT id, uri, primary_artist_id, track_json,
           row_number() OVER (
               PARTITION BY primary_artist_id
               ORDER BY RANDOM()
           ) AS row_number
    FROM saved_tracks
    WHERE release_year <= ?
)
WHERE row_number <= ?;

selectSavedTracksSinceYearPerArtist:
SELECT id, uri, primary_artist_id, track_json
FROM (
    SELECT id, uri, primary_artist_id, track_json,
           row_number() OVER (
               PARTITION BY primary_artist_id
               ORDER BY RANDOM()
           ) AS row_number
    FROM saved_tracks
    WHERE release_year >= ?
)
WHERE row_number <= ?;

selectSavedTracksNotByTopArtists:
SELECT id, uri, primary_artist_id, track_json
FROM saved_tracks
WHERE primary_artist_id NOT IN (SELECT id FROM top_artists);

selectSavedTracksNotInTopTracks:
SELECT id, uri, primary_artist_id, track_json
FROM saved_tracks
WHERE id NOT IN (SELECT id FROM top_tracks);

selectSavedTracksInYearRange:
SELECT id, uri, primary_artist_id, track_json
FROM saved_tracks
WHERE release_year >= ? AND release_year < ?;

selectPlaylistByName:
SELECT id, snapshot_id
FROM playlists
WHERE name = ?;

selectPlaylistTracksByName:
SELECT id, uri, track_json
FROM playlist_tracks
WHERE playlist_name = ?;

selectCacheMetadata:
SELECT singleton_id, cache_revision, sync_timestamp_millis, owner_spotify_user_id, completion_state
FROM cache_metadata
WHERE singleton_id = 1;

selectPlaylistDetailsById:
SELECT playlist_id, description, is_public, collaborative, owner_id, snapshot_id, item_count, display_url
FROM playlist_details
WHERE playlist_id = ?;

selectPlaylistItemsById:
SELECT playlist_id, position, added_at, added_by_id, is_local, item_type, is_playable,
       item_id, item_uri, status, complete_item_json
FROM playlist_items
WHERE playlist_id = ?
ORDER BY position;

selectAllSongs:
SELECT id, name, href, uri, album_id, album_name, album_href, album_uri, release_date,
       duration_ms, explicit, available, track_json
FROM songs
ORDER BY id;

selectSongArtists:
SELECT track_id, position, artist_id, name, href, uri
FROM song_artists
WHERE track_id = ?
ORDER BY position;

selectManagedPlaylist:
SELECT definition_id, definition_revision, spotify_playlist_id, owner_spotify_user_id
FROM managed_playlists
WHERE definition_id = ? AND definition_revision = ? AND owner_spotify_user_id = ?;

insertCacheMetadata:
INSERT INTO cache_metadata (singleton_id, cache_revision, sync_timestamp_millis, owner_spotify_user_id, completion_state)
VALUES (1, ?, ?, ?, ?);

clearCacheMetadata:
DELETE FROM cache_metadata;

clearPlaylistDetails:
DELETE FROM playlist_details;

clearPlaylistItems:
DELETE FROM playlist_items;

clearPlaylistItemsById:
DELETE FROM playlist_items
WHERE playlist_id = ?;

clearSongs:
DELETE FROM songs;

clearSongArtists:
DELETE FROM song_artists;

insertPlaylistDetails:
INSERT INTO playlist_details (
    playlist_id, description, is_public, collaborative, owner_id, snapshot_id, item_count, display_url
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertPlaylistItem:
INSERT INTO playlist_items (
    playlist_id, position, added_at, added_by_id, is_local, item_type, is_playable,
    item_id, item_uri, status, complete_item_json
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertSong:
INSERT INTO songs (
    id, name, href, uri, album_id, album_name, album_href, album_uri, release_date,
    duration_ms, explicit, available, track_json
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertSongArtist:
INSERT INTO song_artists (track_id, position, artist_id, name, href, uri)
VALUES (?, ?, ?, ?, ?, ?);

insertManagedPlaylist:
INSERT INTO managed_playlists (
    definition_id, definition_revision, spotify_playlist_id, owner_spotify_user_id
)
VALUES (?, ?, ?, ?)
ON CONFLICT(definition_id, definition_revision) DO UPDATE SET
    spotify_playlist_id = excluded.spotify_playlist_id,
    owner_spotify_user_id = excluded.owner_spotify_user_id;

updatePlaylistSnapshot:
UPDATE playlist_details
SET snapshot_id = ?, item_count = ?
WHERE playlist_id = ?;
